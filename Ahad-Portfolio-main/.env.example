# Contact form (optional). Without RESEND_API_KEY the form tells visitors it
# can't send and offers to open their email app with the message prefilled.
RESEND_API_KEY=
# Where messages are delivered. Defaults to the email in data/profile.ts.
CONTACT_TO_EMAIL=
# Sender address. Must be on a domain verified in Resend; the default
# onboarding@resend.dev only delivers to the Resend account owner's email.
CONTACT_FROM_EMAIL=

# Public site URL used for canonical links, sitemap and share images,
# e.g. https://your-domain.com. On Vercel this falls back to the project URL.
NEXT_PUBLIC_SITE_URL=
